# Environment Configuration
PORT=3001
NODE_ENV=development

# Spec 0006: npm run seed refuses when NODE_ENV=production. Set SEED_ALLOW=staging only in the
# staging environment's settings to let it run there (without the broken state accounts).
# Never set it on production. Any other value counts as unset.
# SEED_ALLOW=

# Required (spec 0010). Browser origins allowed by CORS, comma separated, each a bare origin like
# https://host (no path, no trailing slash). Local development origins are always allowed.
CORS_ORIGINS=http://localhost:8000,http://localhost:8001

# The portal's public base URL, for the links in setup and reset emails (spec 0009), the
# portal's web address in the client registry, and the one Origin the SSO cookie routes accept.
# Required (spec 0010); in production it must be https and not localhost.
PORTAL_URL=http://localhost:8000

# Database Connection (Docker local config by default)
DATABASE_URL="postgresql://welinc_auth_user:welinc_auth_pass@localhost:5432/welinc_auth_db?schema=public"
# Most connections this service opens at once (VRMS spec 0008: 3 when hosted, a server has about 35)
DB_POOL_MAX=5

# Tokens (spec 0002). Run `npm run keys:dev` once locally: it writes AUTH_SIGNING_KEYS,
# CLIENT_VRMS_JWKS and AUTH_ISSUER into .env (and the VRMS client key into backend-vrms/.env).
# The issuer of spec 0001 section 1: an identifier compared character for character, never fetched.
# Every service sets the identical string.
AUTH_ISSUER=http://localhost:3000/auth
# Private ES256 signing keys with their status (current, next, retired), as one line of JSON.
# Secret. Rotate with `npm run keys:rotate`; see docs/keys.md.
AUTH_SIGNING_KEYS=
# Each client's public keys, read by the seed: {"keys":[...]}. Not secret.
CLIENT_VRMS_JWKS=
# Proxy hops in front of welinc-auth, so rate limits see the real caller: 1 locally (nginx),
# 2 hosted (the Container Apps ingress plus nginx). 0 trusts none; production refuses 0 (spec 0010).
TRUST_PROXY_HOPS=1
# Token lifetimes in minutes, 1 to 60. ACCESS_TOKEN_MINUTES must be at most WEB_SESSION_IDLE_MINUTES.
ACCESS_TOKEN_MINUTES=15
SERVICE_TOKEN_MINUTES=5

# Sessions (spec 0003). A web session ends after WEB_SESSION_IDLE_MINUTES without user input
# or WEB_SESSION_MAX_HOURS after login; a mobile one after MOBILE_SESSION_IDLE_DAYS without a
# refresh. A rotated refresh token may be presented again for REFRESH_REUSE_GRACE_SECONDS.
# WEB_SESSION_IDLE_MINUTES must be at most WEB_SESSION_MAX_HOURS x 60. Unset numbers take the values shown.
WEB_SESSION_IDLE_MINUTES=30
WEB_SESSION_MAX_HOURS=12
MOBILE_SESSION_IDLE_DAYS=7
REFRESH_REUSE_GRACE_SECONDS=10
MAX_SESSIONS_PER_USER=10
SESSION_RETENTION_DAYS=90
# Spec 0011: days to keep sign in, session and code events (30 to 3650). Account changes are kept forever.
ACCOUNT_EVENT_RETENTION_DAYS=365
# Spec 0012: days between a deletion (approved or by an admin) and the erasure of personal data (1 to 365). Restore works until then.
ACCOUNT_ERASURE_GRACE_DAYS=30
# Spec 0011: the DB-IP Lite files npm run geo:fetch downloads. Missing files are fine: places stay empty.
GEOIP_COUNTRY_FILE=geo/dbip-country-lite.mmdb
GEOIP_ASN_FILE=geo/dbip-asn-lite.mmdb
# true or false. Must be true in production: the SSO cookie becomes __Secure-welinc_sso with the Secure flag.
SSO_COOKIE_SECURE=false
# Spec 0013: true (the default) asks every admin for an emailed code at each portal sign in.
# Production refuses false. Locally, mail to a seed address (@welinc.com) is never sent: the whole
# email, code included, is printed to docker logs welinc_auth_service. Real addresses go through
# SMTP_* as usual. Set false only if you want to skip the code entirely.
ADMIN_SIGN_IN_CODE=true
# VRMS spec 0026: true or false. The API docs at /auth/docs (Scalar) and /auth/docs/openapi.json.
# Blank means on unless NODE_ENV=production. Hosted, the Bicep sets it: true on staging, false on production.
API_DOCS_ENABLED=

# The client registry's addresses, read by `npm run seed:clients` (spec 0003). The gateway
# address the browser sees; each system's callback is <API_PUBLIC_URL>/<sys>/session/callback.
API_PUBLIC_URL=http://localhost:3000
# Each system's web address, where users land after login (local defaults shown)
CLIENT_VRMS_WEB_ADDRESS=http://localhost:8001
CLIENT_VMMS_WEB_ADDRESS=http://localhost:8002
CLIENT_BMS_WEB_ADDRESS=http://localhost:8003

# Email (OTP and password reset). Host, user and pass are required in production (spec 0010).
# Leave them blank in development to log emails instead of sending (the app warns at boot).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=WeLinc Logistics <no-reply@welinc.com>

# Error monitoring (VRMS spec 0025). Leave all four blank locally: monitoring is off and nothing is sent.
# Prove it on staging, not from your laptop: a local app with SENTRY_ENVIRONMENT=staging reports as
# staging, and its errors mix with staging's issues.
# After changing any of these, recreate the container (docker compose -f docker-compose.shared.yml up -d auth-service).
# The DSN can only send events, so it is not a secret. Hosted, the Bicep sets all of these.
SENTRY_DSN=
# staging or production; required when SENTRY_DSN is set
SENTRY_ENVIRONMENT=
# The commit SHA. Hosted, the image bakes it in from the GIT_SHA build argument.
SENTRY_RELEASE=
# true or false. Staging only: POST /auth/admin/debug/sentry-test throws a test error (a suite
# admin's admin session). Refused with SENTRY_ENVIRONMENT=production.
SENTRY_TEST_ROUTES=

# true or false (spec 0009, AC-32). Staging only: mail to a seed address (welinc.com and the other
# made up domains) is printed to the log instead of sent, as it already is locally. Leave it blank
# here: outside production seed mail is logged anyway. Refused with SENTRY_ENVIRONMENT=production.
# SEED_MAIL_TO_LOG=

# Spec 0009, AC-33. Staging only: mail to a seed address goes to this team inbox instead, {tag}
# replaced by the seed address's name (vrms.admin@welinc.com goes to team+vrms.admin@gmail.com).
# Beats SEED_MAIL_TO_LOG. Leave it blank here unless you want seed mail in a real inbox on purpose.
# Refused with SENTRY_ENVIRONMENT=production.
# SEED_MAIL_REDIRECT=
