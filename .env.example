# Environment Configuration
PORT=3001
NODE_ENV=development

# Extra browser origins allowed by CORS, comma separated (localhost is always allowed)
CORS_ORIGINS=http://localhost:8000,http://localhost:8001

# The portal's public base URL, for the links in setup and reset emails (spec 0009), the
# portal's web address in the client registry, and the one Origin the SSO cookie routes accept.
# Required when NODE_ENV=production; falls back to http://localhost:8000 otherwise.
PORTAL_URL=http://localhost:8000

# Database Connection (Docker local config by default)
DATABASE_URL="postgresql://welinc_auth_user:welinc_auth_pass@localhost:5432/welinc_auth_db?schema=public"

# Tokens (spec 0002). Run `npm run keys:dev` once locally: it writes AUTH_SIGNING_KEYS,
# CLIENT_VRMS_JWKS and AUTH_ISSUER into .env (and the VRMS client key into backend-vrms/.env).
# The issuer of spec 0001 section 1: an identifier compared character for character, never fetched.
# Every service sets the identical string.
AUTH_ISSUER=http://localhost:3000/auth
# Private ES256 signing keys with their status (current, next, retired), as one line of JSON.
# Secret. Rotate with `npm run keys:rotate`; see docs/keys.md.
AUTH_SIGNING_KEYS=
# Each client's public keys, read by the seed: {"keys":[...]}. Not secret.
CLIENT_VRMS_JWKS=
# Proxy hops in front of welinc-auth, so rate limits see the real caller: 1 locally (nginx),
# 2 hosted (the Container Apps ingress plus nginx). Unset trusts none.
TRUST_PROXY_HOPS=1
# Token lifetimes in minutes
ACCESS_TOKEN_MINUTES=15
SERVICE_TOKEN_MINUTES=5

# Sessions (spec 0003). A web session ends after WEB_SESSION_IDLE_MINUTES without user input
# or WEB_SESSION_MAX_HOURS after login; a mobile one after MOBILE_SESSION_IDLE_DAYS without a
# refresh. A rotated refresh token may be presented again for REFRESH_REUSE_GRACE_SECONDS.
WEB_SESSION_IDLE_MINUTES=30
WEB_SESSION_MAX_HOURS=12
MOBILE_SESSION_IDLE_DAYS=7
REFRESH_REUSE_GRACE_SECONDS=10
MAX_SESSIONS_PER_USER=10
SESSION_RETENTION_DAYS=90
# true when hosted: the SSO cookie becomes __Secure-welinc_sso with the Secure flag
SSO_COOKIE_SECURE=false

# The client registry's addresses, read by `npm run seed:clients` (spec 0003). The gateway
# address the browser sees; each system's callback is <API_PUBLIC_URL>/<sys>/session/callback.
API_PUBLIC_URL=http://localhost:3000
# Each system's web address, where users land after login (local defaults shown)
CLIENT_VRMS_WEB_ADDRESS=http://localhost:8001
CLIENT_VMMS_WEB_ADDRESS=http://localhost:8002
CLIENT_BMS_WEB_ADDRESS=http://localhost:8003

# Email (OTP and password reset). Leave blank to log emails instead of sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=WeLinc Logistics <no-reply@welinc.com>
