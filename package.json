{
  "name": "welinc-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "prebuild": "node scripts/check-no-user-role.mjs",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "env:check": "node --env-file-if-exists=.env dist/src/config/check-env.js",
    "openapi": "nest build && node dist/src/openapi/write.js",
    "openapi:check": "nest build && node dist/src/openapi/write.js --check",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:ci": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:db": "jest --config ./test/jest-db.json --runInBand",
    "seed": "ts-node -r tsconfig-paths/register prisma/seed.ts",
    "studio": "prisma studio --port 5555 --browser none",
    "keys:dev": "ts-node scripts/keys-dev.ts",
    "seed:clients": "ts-node -r tsconfig-paths/register prisma/seed-clients.ts",
    "seed:check": "ts-node -r tsconfig-paths/register prisma/seed-check.ts",
    "catalog:sync": "ts-node -r tsconfig-paths/register prisma/catalog-sync.ts",
    "permissions:import": "ts-node -r tsconfig-paths/register prisma/permissions-import.ts",
    "db:deploy": "prisma migrate deploy && npm run catalog:sync",
    "keys:rotate": "ts-node scripts/keys-rotate.ts",
    "keys:client": "ts-node scripts/keys-client.ts",
    "admin:recover": "ts-node -r tsconfig-paths/register scripts/admin-recover.ts",
    "geo:fetch": "node scripts/geo-fetch.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.10",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.2.9",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.8",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@scalar/api-reference": "^1.78.1",
    "@scalar/nestjs-api-reference": "^1.2.37",
    "argon2": "^0.44.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "jose": "^6.2.17",
    "maxmind": "5.0.8",
    "nodemailer": "^10.5.0",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "dotenv": "^17.4.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "prettier": "^3.10.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": {
            "allowJs": true,
            "module": "commonjs",
            "moduleResolution": "node10",
            "resolvePackageJsonExports": false
          }
        }
      ]
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "transformIgnorePatterns": [
      "/node_modules/(?!jose/)"
    ],
    "setupFiles": [
      "<rootDir>/config/test-env.setup.ts"
    ]
  },
  "prisma": {
    "seed": "ts-node -r tsconfig-paths/register prisma/seed.ts"
  },
  "overrides": {
    "glob@>=9.0.0 <14.0.2": "^14.0.4",
    "minimatch@>=7.0.0 <11.0.1": "^11.0.5"
  }
}
