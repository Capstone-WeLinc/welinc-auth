// This is your Prisma schema file for the Auth Service
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum SystemType {
  VRMS
  VMMS
  BMS
}

// Spec 0011: what an account event is about. Each type belongs to one category (the map in
// src/auth/events/event-types.ts; the migration's CHECK constraint is written from it).
enum AccountEventCategory {
  SIGN_IN
  SESSION
  CODE
  ACCOUNT
}

enum AccountEventType {
  // SIGN_IN
  SIGNED_IN
  SIGN_IN_FAILED
  LOCKED_OUT
  // SESSION
  SYSTEM_OPENED
  SIGNED_OUT
  SESSION_ENDED
  // CODE
  CODE_SENT
  CODE_MAIL_FAILED
  CODE_USED
  CODE_RETIRED
  // ACCOUNT
  CREATED
  UPDATED
  ROLE_CHANGED
  ACTIVATED
  DEACTIVATED
  UNLOCKED
  DELETED
  SESSIONS_ENDED
  PASSWORD_CHANGED
  PICTURE_CHANGED
  // Spec 0012: SIGN_IN
  PASSWORD_CONFIRMED
  PASSWORD_CONFIRM_FAILED
  // Spec 0012: ACCOUNT
  DELETION_REQUESTED
  DELETION_CANCELLED
  DELETION_REJECTED
  RESTORED
  ERASED
  // Spec 0013: ACCOUNT (kept forever)
  SUITE_ADMIN_ACTIONED
  SUITE_ADMIN_REMOVED
  TEMP_ACCESS_STARTED
  TEMP_ACCESS_ENDED
  ADMIN_RECOVERY
  // Spec 0013: SIGN_IN
  ADMIN_CODE_PASSED
}

// Spec 0003: a login is a session that welinc-auth tracks on the server.
enum SessionKind {
  WEB
  MOBILE
}

enum SessionEndReason {
  LOGOUT
  IDLE
  MAX_AGE
  USER_ENDED
  ADMIN_ENDED
  DEACTIVATED
  DELETED
  PASSWORD_CHANGED
  REFRESH_REUSE
  CODE_REUSE
  MAX_SESSIONS
  // Spec 0013, AC-10: a temporary grant ended, so the holder's sessions in that system end
  TEMP_ACCESS_ENDED
}

model User {
  id                   String                   @id @default(uuid()) @db.Uuid
  name                 String                   @db.VarChar(100)
  email                String                   @unique @map("email") @db.VarChar(255)
  emailVerified        Boolean                  @default(false) @map("email_verified")
  // Spec 0009, AC-16: true once a setup or reset code was used; never turns back to false
  passwordSet          Boolean                  @default(false) @map("password_set")
  passwordHash         String                   @map("password_hash") @db.VarChar(255)
  contact              String?                  @db.VarChar(100)
  profilePicture       String?                  @map("profile_picture") @db.Text
  isActive             Boolean                  @default(true) @map("is_active")
  failedLoginAttempts  Int                      @default(0) @map("failed_login_attempts")
  lockedAt             DateTime?                @map("locked_at") @db.Timestamptz(6)
  deletedAt            DateTime?                @map("deleted_at") @db.Timestamptz(6)
  // Spec 0012: personal data replaced by "Deleted user"; never cleared
  erasedAt             DateTime?                @map("erased_at") @db.Timestamptz(6)
  createdAt            DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  roles                UserRoleAssignment[]
  verificationCodes    VerificationCode[]
  sessions             Session[]                @relation("UserSessions")
  sessionsEnded        Session[]                @relation("SessionsEndedBy")
  events               AccountEvent[]           @relation("AccountEvents")
  eventsMade           AccountEvent[]           @relation("AccountEventsMade")
  deletionRequests     AccountDeletionRequest[] @relation("DeletionRequests")
  deletionsDecided     AccountDeletionRequest[] @relation("DeletionDecidedBy")
  deletionsRestored    AccountDeletionRequest[] @relation("DeletionRestoredBy")
  reauthTokens         ReauthToken[]
  suiteAdmin           SuiteAdmin?              @relation("SuiteAdmin")
  suiteAdminsGranted   SuiteAdmin[]             @relation("SuiteAdminGrantedBy")
  temporaryGrants      TemporaryGrant[]         @relation("TemporaryGrants")
  temporaryGrantsEnded TemporaryGrant[]         @relation("TemporaryGrantsEnded")
  permissionCells      RolePermission[]         @relation("RolePermissionUpdatedBy")
  permissionChanges    PermissionChange[]       @relation("PermissionChangeActor")

  @@index([deletedAt])
  @@map("users")
}

// Spec 0004: each system's roles, written only by `npm run catalog:sync` from prisma/catalog/
// (and the migration that created them). No route edits them.
model System {
  code            SystemType   @id
  name            String       @db.VarChar(100)
  // One line for the portal launcher card, written only by catalog:sync (spec 0007)
  description     String       @db.VarChar(200)
  // Null means no limit; at least 1 when set (checked by the sync)
  maxRolesPerUser Int?         @map("max_roles_per_user")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  roles           SystemRole[]
  permissions     SystemPermission[]
  matrix          PermissionMatrix?

  @@map("systems")
}

// Spec 0013, AC-25: a system's permission keys, written only by `npm run catalog:sync` from the
// `permissions` list in prisma/catalog/<system>.ts. No route edits them.
model SystemPermission {
  system      SystemType
  key         String           @db.VarChar(60)
  label       String           @db.VarChar(100)
  group       String           @db.VarChar(40)
  description String           @db.VarChar(300)
  // Position in the catalog file (display order)
  sortOrder   Int              @map("sort_order")
  // Roles whose cell always equals its default (AC-27 refuses edits, the sync resets them)
  lockedRoles String[]         @map("locked_roles") @db.VarChar(40)
  systemRef   System           @relation(fields: [system], references: [code], onDelete: Restrict, onUpdate: Restrict)
  cells       RolePermission[]

  @@id([system, key])
  @@map("system_permissions")
}

// Spec 0013, AC-25 and AC-27: whether a role holds a permission. Inserted by catalog:sync with
// the default, edited by suite admins; locked cells only by the sync.
model RolePermission {
  system      SystemType
  role        String           @db.VarChar(40)
  key         String           @db.VarChar(60)
  allowed     Boolean
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById String?          @map("updated_by_id") @db.Uuid
  roleRef     SystemRole       @relation(fields: [system, role], references: [system, code], onDelete: Cascade, onUpdate: Restrict)
  permission  SystemPermission @relation(fields: [system, key], references: [system, key], onDelete: Cascade, onUpdate: Restrict)
  updatedBy   User?            @relation("RolePermissionUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@id([system, role, key])
  @@map("role_permissions")
}

// Spec 0013, AC-26: one per system; `version` is the ETag systems poll with. Raised with
// `version = version + 1` by every write that changes a cell.
model PermissionMatrix {
  system    SystemType @id
  version   Int        @default(1)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  systemRef System     @relation(fields: [system], references: [code], onDelete: Restrict, onUpdate: Restrict)

  @@map("permission_matrices")
}

// Spec 0013, AC-25, AC-27 and AC-28: one row per changed cell, append only by trigger (migration
// SQL); erasure may blank actor_name and actor_email. No FK on role or key: history outlives the
// catalog.
model PermissionChange {
  id         String     @id @default(uuid()) @db.Uuid
  system     SystemType
  role       String     @db.VarChar(40)
  key        String     @db.VarChar(60)
  // Null when the cell was created
  before     Boolean?
  // Null when the cell was removed
  after      Boolean?
  actorId    String?    @map("actor_id") @db.Uuid
  // "Catalog sync" when the sync wrote it
  actorName  String?    @map("actor_name") @db.VarChar(100)
  actorEmail String?    @map("actor_email") @db.VarChar(255)
  note       String?    @db.VarChar(500)
  // Copied from VRMS by permissions:import (AC-28)
  imported   Boolean    @default(false)
  // Millisecond precision so keyset cursors match exactly (as account_events)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  actor      User?      @relation("PermissionChangeActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([system, createdAt(sort: Desc), id(sort: Desc)])
  @@map("permission_changes")
}

model SystemRole {
  system          SystemType
  // ^[A-Z][A-Z0-9_]{1,39}$, never changed once synced
  code            String               @db.VarChar(40)
  name            String               @db.VarChar(60)
  description     String               @db.VarChar(200)
  // Position in the catalog file: display order and power order (0 is the most powerful)
  sortOrder       Int                  @map("sort_order")
  // Exactly one per system, checked by the sync
  isSystemAdmin   Boolean              @default(false) @map("is_system_admin")
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  systemRef       System               @relation(fields: [system], references: [code], onDelete: Restrict, onUpdate: Restrict)
  assignments     UserRoleAssignment[]
  temporaryGrants TemporaryGrant[]
  permissionCells RolePermission[]

  @@id([system, code])
  @@map("system_roles")
}

model UserRoleAssignment {
  id               String     @id @default(uuid()) @db.Uuid
  userId           String     @map("user_id") @db.Uuid
  role             String     @db.VarChar(40)
  system           SystemType
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  // Spec 0013, AC-9: set when a temporary grant gave this row; a suite admin's rows always have it
  // (a deferred trigger in the migration SQL raises suite_admin_no_roles otherwise)
  temporaryGrantId String?    @unique @map("temporary_grant_id") @db.Uuid

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  systemRole     SystemRole      @relation(fields: [system, role], references: [system, code], onDelete: Restrict, onUpdate: Restrict)
  temporaryGrant TemporaryGrant? @relation(fields: [temporaryGrantId], references: [id], onDelete: Restrict)

  @@unique([userId, role, system])
  @@map("user_roles")
}

// Spec 0009: every emailed code, one table for all kinds. Only hashes are stored. "Live" means
// used_at is null and expires_at is after now. The migration also holds what Prisma can't say:
// a check constraint (challenge_hash only on SIGN_IN rows, new_email only on EMAIL_CHANGE rows)
// and a unique index on challenge_hash where it is not null.
enum VerificationPurpose {
  PASSWORD_SETUP
  PASSWORD_RESET
  SIGN_IN
  EMAIL_CHANGE
}

model VerificationCode {
  id            String              @id @default(uuid()) @db.Uuid
  userId        String              @map("user_id") @db.Uuid
  purpose       VerificationPurpose
  // argon2 of the 6 digits
  codeHash      String              @map("code_hash") @db.Text
  // SHA-256 hex of the sign in ticket; SIGN_IN only
  challengeHash String?             @map("challenge_hash") @db.Char(64)
  // Lowercased; EMAIL_CHANGE only
  newEmail      String?             @map("new_email") @db.VarChar(255)
  attempts      Int                 @default(0)
  expiresAt     DateTime            @map("expires_at") @db.Timestamptz(6)
  // Used, or retired by a newer code, the 5th wrong try, or an email change
  usedAt        DateTime?           @map("used_at") @db.Timestamptz(6)
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt(sort: Desc)])
  @@map("verification_codes")
}

// Spec 0003: one row per login. "Expired" is never stored: a live row past a cutoff is ended
// (IDLE or MAX_AGE) by the first call that sees it. An ended row never becomes live again.
model Session {
  id                String            @id @default(uuid()) @db.Uuid
  userId            String            @map("user_id") @db.Uuid
  kind              SessionKind
  loginClientId     String            @map("login_client_id") @db.VarChar(64)
  deviceName        String?           @map("device_name") @db.VarChar(100)
  userAgent         String?           @map("user_agent") @db.VarChar(512)
  createdIp         String?           @map("created_ip") @db.VarChar(45)
  lastSeenIp        String?           @map("last_seen_ip") @db.VarChar(45)
  // SHA-256 hex of the welinc_sso handle; web only
  ssoHandleHash     String?           @unique @map("sso_handle_hash") @db.Char(64)
  // Each system an access token was signed for (shown as `systems`)
  audiences         SystemType[]      @default([])
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  lastActivityAt    DateTime          @map("last_activity_at") @db.Timestamptz(6)
  idleExpiresAt     DateTime          @map("idle_expires_at") @db.Timestamptz(6)
  // Web: created_at + WEB_SESSION_MAX_HOURS; mobile: null
  absoluteExpiresAt DateTime?         @map("absolute_expires_at") @db.Timestamptz(6)
  endedAt           DateTime?         @map("ended_at") @db.Timestamptz(6)
  endReason         SessionEndReason? @map("end_reason")
  endedById         String?           @map("ended_by_id") @db.Uuid
  // Spec 0013, AC-5 to AC-7: when this session passed an emailed code (login or step up); never cleared
  signInCodeAt      DateTime?         @map("sign_in_code_at") @db.Timestamptz(6)

  user               User                @relation("UserSessions", fields: [userId], references: [id], onDelete: NoAction)
  endedBy            User?               @relation("SessionsEndedBy", fields: [endedById], references: [id], onDelete: SetNull)
  loginClient        OAuthClient         @relation("SessionLoginClient", fields: [loginClientId], references: [id])
  refreshTokens      RefreshToken[]
  authorizationCodes AuthorizationCode[]
  reauthTokens       ReauthToken[]

  @@index([userId, endedAt])
  @@index([endedAt])
  @@map("sessions")
}

// Spec 0003: one row per issued refresh token, chained by parent. Only SHA-256 hashes are stored.
// At most one unused token per (session, client): a partial unique index in the migration.
model RefreshToken {
  id          String    @id @default(uuid()) @db.Uuid
  sessionId   String    @map("session_id") @db.Uuid
  clientId    String    @map("client_id") @db.VarChar(64)
  tokenHash   String    @unique @map("token_hash") @db.Char(64)
  parentId    String?   @unique @map("parent_id") @db.Uuid
  usedAt      DateTime? @map("used_at") @db.Timestamptz(6)
  // The child token, AES-256-GCM under a key derived from this row's token; cleared after grace
  graceCipher Bytes?    @map("grace_cipher")
  graceUntil  DateTime? @map("grace_until") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  session Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  client  OAuthClient   @relation("RefreshTokenClient", fields: [clientId], references: [id])
  parent  RefreshToken? @relation("RefreshTokenChain", fields: [parentId], references: [id], onDelete: SetNull)
  child   RefreshToken? @relation("RefreshTokenChain")

  @@map("refresh_tokens")
}

// Spec 0003: checked /auth/authorize parameters, waiting for the portal login. Used once, 10 minutes.
model LoginRequest {
  idHash        String    @id @map("id_hash") @db.Char(64)
  clientId      String    @map("client_id") @db.VarChar(64)
  redirectUri   String    @map("redirect_uri") @db.Text
  state         String    @db.Text
  codeChallenge String    @map("code_challenge") @db.Text
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt        DateTime? @map("used_at") @db.Timestamptz(6)

  client OAuthClient @relation("LoginRequestClient", fields: [clientId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("login_requests")
}

// Spec 0003: a one time login code, 60 s, bound to client, redirect address, PKCE challenge and sid.
model AuthorizationCode {
  codeHash      String    @id @map("code_hash") @db.Char(64)
  clientId      String    @map("client_id") @db.VarChar(64)
  sessionId     String    @map("session_id") @db.Uuid
  redirectUri   String    @map("redirect_uri") @db.Text
  codeChallenge String    @map("code_challenge") @db.Text
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt        DateTime? @map("used_at") @db.Timestamptz(6)

  client  OAuthClient @relation("AuthorizationCodeClient", fields: [clientId], references: [id], onDelete: Cascade)
  session Session     @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("authorization_codes")
}

// Spec 0011: everything that happened to an account, in one append only table (replaces
// user_changes). The migration also holds what Prisma can't say: the CHECK that `type` belongs
// to `category`, and the trigger that refuses UPDATE always and DELETE unless it is a non
// ACCOUNT row deleted by the sweep (`welinc.event_sweep` = 'on'). Never holds a password, code,
// hash, token, challenge id or SSO handle (AC-21). Rows are written in the transaction of the
// action they record (AC-7).
model AccountEvent {
  id           String               @id @default(uuid()) @db.Uuid
  userId       String               @map("user_id") @db.Uuid
  // Null: nobody acted (idle end, automatic lock). Equal to userId: the person did it
  actorId      String?              @map("actor_id") @db.Uuid
  category     AccountEventCategory
  type         AccountEventType
  // Fail reason, session end reason, or code purpose
  reason       String?              @db.VarChar(40)
  // The system the event belongs to; null means account wide
  system       SystemType?
  // Plain sid, no relation: sessions are purged after SESSION_RETENTION_DAYS
  sessionId    String?              @map("session_id") @db.Uuid
  clientId     String?              @map("client_id") @db.Text
  field        String?              @db.VarChar(50)
  oldValue     String?              @map("old_value") @db.Text
  newValue     String?              @map("new_value") @db.Text
  attemptsLeft Int?                 @map("attempts_left") @db.SmallInt
  ip           String?              @db.Inet
  device       String?              @db.VarChar(100)
  userAgent    String?              @map("user_agent") @db.VarChar(512)
  // From the offline DB-IP Lite files at write time, when present
  country      String?              @db.Char(2)
  network      String?              @db.VarChar(120)
  asn          Int?
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  user  User  @relation("AccountEvents", fields: [userId], references: [id], onDelete: Restrict)
  actor User? @relation("AccountEventsMade", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([system, createdAt(sort: Desc), id(sort: Desc)])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([ip, createdAt(sort: Desc)])
  @@map("account_events")
}

// Spec 0002: who may ask welinc-auth for tokens (spec 0001 section 4). Seeded from env by
// `npm run seed:clients`. Holds public keys only, never a client's private key.
enum ClientKind {
  FIRST_PARTY_WEB
  CONFIDENTIAL
  PUBLIC_NATIVE
  SERVICE
}

model OAuthClient {
  id            String               @id @db.VarChar(64)
  kind          ClientKind
  // Null only for the portal
  system        SystemType?
  // authorization_code, refresh_token, client_credentials, mobile_login, sso
  grants        String[]
  userAudiences String[]             @map("user_audiences")
  // { "<audience>": ["<scope>", ...] }
  serviceScopes Json                 @default("{}") @map("service_scopes")
  redirectUris  String[]             @default([]) @map("redirect_uris")
  webAddress    String?              @map("web_address") @db.VarChar(255)
  // Spec 0004, AC-18: { "<SYSTEM>": ["<role code>", ...] }. A system missing from it means every
  // role of that system may use this client. Set only by seed:clients
  allowedRoles  Json                 @default("{}") @map("allowed_roles")
  // { "keys": [public ES256 JWK with kid] }
  jwks          Json?
  isActive      Boolean              @default(true) @map("is_active")
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  assertionJtis ClientAssertionJti[]
  sessions      Session[]            @relation("SessionLoginClient")
  refreshTokens RefreshToken[]       @relation("RefreshTokenClient")
  loginRequests LoginRequest[]       @relation("LoginRequestClient")
  authCodes     AuthorizationCode[]  @relation("AuthorizationCodeClient")

  @@map("oauth_clients")
}

// A client assertion's jti, kept until it expires so it can't be replayed (spec 0002, AC-17).
// The primary key enforces one use per client, across replicas.
model ClientAssertionJti {
  clientId  String      @map("client_id") @db.VarChar(64)
  jti       String      @db.VarChar(128)
  expiresAt DateTime    @map("expires_at") @db.Timestamptz(6)
  client    OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@id([clientId, jti])
  @@index([expiresAt])
  @@map("client_assertion_jtis")
}

// Spec 0005: the user directory change feed. Both tables, the backfill and the deferred triggers
// that write `directory_changes` live in the hand written migration 20261111000000_directory_feed;
// these models only keep later `migrate dev` runs from dropping them. Never write these tables
// from code: the triggers on `users` and `user_roles` own them.

// One row: the epoch every directory cursor carries (a restored database gets a new one)
model DirectoryFeed {
  id    Boolean @id @default(true)
  epoch String  @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  @@map("directory_feed")
}

model DirectoryChange {
  seq       BigInt              @id @default(autoincrement())
  // pg_current_xact_id() of the writing transaction; read order is (txid, seq)
  txid      Unsupported("xid8") @default(dbgenerated("pg_current_xact_id()"))
  // No relation: a hard delete must keep its `deleted` row
  userId    String              @map("user_id") @db.Uuid
  // created, updated, roles_changed, activated, deactivated, deleted (check constraint)
  type      String
  systems   SystemType[]
  // { id, name, email, contact, profilePicture, isActive, deletedAt, updatedAt, roles }
  snapshot  Json
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([txid, userId])
  @@index([txid, seq])
  @@index([userId, txid, seq])
  @@index([systems], type: Gin)
  @@map("directory_changes")
}

// Spec 0012: a person's request to delete their own account. One PENDING per person (a partial
// unique index in the migration). Every change locks the users row first, then this row, and
// moves status only from the state it expects.
enum DeletionRequestStatus {
  PENDING
  CANCELLED
  REJECTED
  APPROVED
  RESTORED
  ERASED
}

model AccountDeletionRequest {
  id            String                @id @default(uuid()) @db.Uuid
  userId        String                @map("user_id") @db.Uuid
  status        DeletionRequestStatus @default(PENDING)
  // Blanked at erasure
  reason        String?               @db.VarChar(500)
  requestedAt   DateTime              @default(now()) @map("requested_at") @db.Timestamptz(6)
  decidedById   String?               @map("decided_by_id") @db.Uuid
  decidedSystem SystemType?           @map("decided_system")
  decidedAt     DateTime?             @map("decided_at") @db.Timestamptz(6)
  // Required on reject, kept after erasure (blanked only by the erasure itself, AC-15)
  decisionNote  String?               @map("decision_note") @db.VarChar(500)
  cancelledAt   DateTime?             @map("cancelled_at") @db.Timestamptz(6)
  restoredAt    DateTime?             @map("restored_at") @db.Timestamptz(6)
  restoredById  String?               @map("restored_by_id") @db.Uuid
  erasedAt      DateTime?             @map("erased_at") @db.Timestamptz(6)

  user       User  @relation("DeletionRequests", fields: [userId], references: [id], onDelete: Restrict)
  decidedBy  User? @relation("DeletionDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict)
  restoredBy User? @relation("DeletionRestoredBy", fields: [restoredById], references: [id], onDelete: Restrict)

  @@index([status, requestedAt])
  @@index([userId])
  @@map("account_deletion_requests")
}

// Spec 0012: what a reauth token may be used for.
enum ReauthPurpose {
  ACCOUNT_DELETION
  // Spec 0013, AC-14
  ADMIN_ACTION
  TEMPORARY_ACCESS
}

// Spec 0013, AC-1 to AC-4: the suite admins, 1 to 3 people who hold no permanent system role
// (a deferred trigger in the migration SQL enforces that once user_roles can hold temporary rows).
model SuiteAdmin {
  userId      String   @id @map("user_id") @db.Uuid
  // Null: the seed or the recovery script
  grantedById String?  @map("granted_by_id") @db.Uuid
  grantedAt   DateTime @default(now()) @map("granted_at") @db.Timestamptz(6)
  // Null only for the seed
  reason      String?  @db.VarChar(500)

  user      User  @relation("SuiteAdmin", fields: [userId], references: [id], onDelete: Restrict)
  grantedBy User? @relation("SuiteAdminGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@map("suite_admins")
}

// Spec 0013, AC-9 to AC-11: a suite admin's own role in one system for 1 to 8 hours. Live while
// ended_at is null (one live grant per person and system, a partial unique index in the SQL).
// A live grant always has its user_roles row; an ended one never does.
enum TemporaryGrantEnd {
  EXPIRED
  ENDED_EARLY
  SUITE_ADMIN_REMOVED
}

model TemporaryGrant {
  id        String             @id @default(uuid()) @db.Uuid
  userId    String             @map("user_id") @db.Uuid
  system    SystemType
  role      String             @db.VarChar(40)
  reason    String             @db.VarChar(500)
  startedAt DateTime           @default(now()) @map("started_at") @db.Timestamptz(6)
  // 1 to 8 hours after started_at (CHECK in the SQL)
  expiresAt DateTime           @map("expires_at") @db.Timestamptz(6)
  endedAt   DateTime?          @map("ended_at") @db.Timestamptz(6)
  endReason TemporaryGrantEnd? @map("end_reason")
  endedById String?            @map("ended_by_id") @db.Uuid

  user       User                @relation("TemporaryGrants", fields: [userId], references: [id], onDelete: Restrict)
  endedBy    User?               @relation("TemporaryGrantsEnded", fields: [endedById], references: [id], onDelete: SetNull)
  systemRole SystemRole          @relation(fields: [system, role], references: [system, code], onDelete: Restrict, onUpdate: Restrict)
  roleRow    UserRoleAssignment?

  @@index([startedAt(sort: Desc), id(sort: Desc)])
  @@map("temporary_grants")
}

// Spec 0012, AC-1, AC-3: a one use token from `POST /auth/profile/verify-password`, bound to the
// user, the purpose and the session. Only its SHA-256 is stored. The hourly sweep deletes rows
// older than 24 hours.
model ReauthToken {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  sessionId String        @map("session_id") @db.Uuid
  purpose   ReauthPurpose
  tokenHash String        @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime      @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime?     @map("used_at") @db.Timestamptz(6)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@map("reauth_tokens")
}
