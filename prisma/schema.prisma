// This is your Prisma schema file for the Auth Service
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum SystemType {
  VRMS
  VMMS
  BMS
}

enum UserChangeAction {
  CREATED
  UPDATED
  ROLE_CHANGED
  ACTIVATED
  DEACTIVATED
  UNLOCKED
  RESET_SENT
  DELETED
  SESSIONS_ENDED
}

// Spec 0003: a login is a session that welinc-auth tracks on the server.
enum SessionKind {
  WEB
  MOBILE
}

enum SessionEndReason {
  LOGOUT
  IDLE
  MAX_AGE
  USER_ENDED
  ADMIN_ENDED
  DEACTIVATED
  DELETED
  PASSWORD_CHANGED
  REFRESH_REUSE
  CODE_REUSE
  MAX_SESSIONS
}

model User {
  id                  String               @id @default(uuid()) @db.Uuid
  name                String               @db.VarChar(100)
  email               String               @unique @map("email") @db.VarChar(255)
  emailVerified       Boolean              @default(false) @map("email_verified")
  passwordHash        String               @map("password_hash") @db.VarChar(255)
  contact             String?              @db.VarChar(100)
  profilePicture      String?              @map("profile_picture") @db.Text
  isActive            Boolean              @default(true) @map("is_active")
  failedLoginAttempts Int                  @default(0) @map("failed_login_attempts")
  lockedAt            DateTime?            @map("locked_at") @db.Timestamptz(6)
  deletedAt           DateTime?            @map("deleted_at") @db.Timestamptz(6)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  roles               UserRoleAssignment[]
  passwordResetTokens PasswordResetToken[]
  sessions            Session[]            @relation("UserSessions")
  sessionsEnded       Session[]            @relation("SessionsEndedBy")
  changes             UserChange[]         @relation("UserChanges")
  changesMade         UserChange[]         @relation("UserChangesMade")

  @@index([deletedAt])
  @@map("users")
}

// Spec 0004: each system's roles, written only by `npm run catalog:sync` from prisma/catalog/
// (and the migration that created them). No route edits them.
model System {
  code            SystemType   @id
  name            String       @db.VarChar(100)
  // One line for the portal launcher card, written only by catalog:sync (spec 0007)
  description     String       @db.VarChar(200)
  // Null means no limit; at least 1 when set (checked by the sync)
  maxRolesPerUser Int?         @map("max_roles_per_user")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  roles           SystemRole[]

  @@map("systems")
}

model SystemRole {
  system        SystemType
  // ^[A-Z][A-Z0-9_]{1,39}$, never changed once synced
  code          String               @db.VarChar(40)
  name          String               @db.VarChar(60)
  description   String               @db.VarChar(200)
  // Position in the catalog file: display order and power order (0 is the most powerful)
  sortOrder     Int                  @map("sort_order")
  // Exactly one per system, checked by the sync
  isSystemAdmin Boolean              @default(false) @map("is_system_admin")
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  systemRef     System               @relation(fields: [system], references: [code], onDelete: Restrict, onUpdate: Restrict)
  assignments   UserRoleAssignment[]

  @@id([system, code])
  @@map("system_roles")
}

model UserRoleAssignment {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @map("user_id") @db.Uuid
  role      String     @db.VarChar(40)
  system    SystemType
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  systemRole SystemRole @relation(fields: [system, role], references: [system, code], onDelete: Restrict, onUpdate: Restrict)

  @@unique([userId, role, system])
  @@map("user_roles")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id") @db.Uuid
  otp       String
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

// Spec 0003: one row per login. "Expired" is never stored: a live row past a cutoff is ended
// (IDLE or MAX_AGE) by the first call that sees it. An ended row never becomes live again.
model Session {
  id                String            @id @default(uuid()) @db.Uuid
  userId            String            @map("user_id") @db.Uuid
  kind              SessionKind
  loginClientId     String            @map("login_client_id") @db.VarChar(64)
  deviceName        String?           @map("device_name") @db.VarChar(100)
  userAgent         String?           @map("user_agent") @db.VarChar(512)
  createdIp         String?           @map("created_ip") @db.VarChar(45)
  lastSeenIp        String?           @map("last_seen_ip") @db.VarChar(45)
  // SHA-256 hex of the welinc_sso handle; web only
  ssoHandleHash     String?           @unique @map("sso_handle_hash") @db.Char(64)
  // Each system an access token was signed for (shown as `systems`)
  audiences         SystemType[]      @default([])
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  lastActivityAt    DateTime          @map("last_activity_at") @db.Timestamptz(6)
  idleExpiresAt     DateTime          @map("idle_expires_at") @db.Timestamptz(6)
  // Web: created_at + WEB_SESSION_MAX_HOURS; mobile: null
  absoluteExpiresAt DateTime?         @map("absolute_expires_at") @db.Timestamptz(6)
  endedAt           DateTime?         @map("ended_at") @db.Timestamptz(6)
  endReason         SessionEndReason? @map("end_reason")
  endedById         String?           @map("ended_by_id") @db.Uuid

  user               User                @relation("UserSessions", fields: [userId], references: [id], onDelete: NoAction)
  endedBy            User?               @relation("SessionsEndedBy", fields: [endedById], references: [id], onDelete: SetNull)
  loginClient        OAuthClient         @relation("SessionLoginClient", fields: [loginClientId], references: [id])
  refreshTokens      RefreshToken[]
  authorizationCodes AuthorizationCode[]

  @@index([userId, endedAt])
  @@index([endedAt])
  @@map("sessions")
}

// Spec 0003: one row per issued refresh token, chained by parent. Only SHA-256 hashes are stored.
// At most one unused token per (session, client): a partial unique index in the migration.
model RefreshToken {
  id          String    @id @default(uuid()) @db.Uuid
  sessionId   String    @map("session_id") @db.Uuid
  clientId    String    @map("client_id") @db.VarChar(64)
  tokenHash   String    @unique @map("token_hash") @db.Char(64)
  parentId    String?   @unique @map("parent_id") @db.Uuid
  usedAt      DateTime? @map("used_at") @db.Timestamptz(6)
  // The child token, AES-256-GCM under a key derived from this row's token; cleared after grace
  graceCipher Bytes?    @map("grace_cipher")
  graceUntil  DateTime? @map("grace_until") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  session Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  client  OAuthClient   @relation("RefreshTokenClient", fields: [clientId], references: [id])
  parent  RefreshToken? @relation("RefreshTokenChain", fields: [parentId], references: [id], onDelete: SetNull)
  child   RefreshToken? @relation("RefreshTokenChain")

  @@map("refresh_tokens")
}

// Spec 0003: checked /auth/authorize parameters, waiting for the portal login. Used once, 10 minutes.
model LoginRequest {
  idHash        String    @id @map("id_hash") @db.Char(64)
  clientId      String    @map("client_id") @db.VarChar(64)
  redirectUri   String    @map("redirect_uri") @db.Text
  state         String    @db.Text
  codeChallenge String    @map("code_challenge") @db.Text
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt        DateTime? @map("used_at") @db.Timestamptz(6)

  client OAuthClient @relation("LoginRequestClient", fields: [clientId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("login_requests")
}

// Spec 0003: a one time login code, 60 s, bound to client, redirect address, PKCE challenge and sid.
model AuthorizationCode {
  codeHash      String    @id @map("code_hash") @db.Char(64)
  clientId      String    @map("client_id") @db.VarChar(64)
  sessionId     String    @map("session_id") @db.Uuid
  redirectUri   String    @map("redirect_uri") @db.Text
  codeChallenge String    @map("code_challenge") @db.Text
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt        DateTime? @map("used_at") @db.Timestamptz(6)

  client  OAuthClient @relation("AuthorizationCodeClient", fields: [clientId], references: [id], onDelete: Cascade)
  session Session     @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("authorization_codes")
}

// Every admin write to a user, written in the same transaction as the change (spec 0009, AC-20).
// Never holds a password, hash or code. Kept forever; users are soft deleted only.
model UserChange {
  id         String           @id @default(uuid()) @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  actorId    String           @map("actor_id") @db.Uuid
  actorEmail String           @map("actor_email") @db.VarChar(255)
  action     UserChangeAction
  field      String?          @db.VarChar(50)
  oldValue   String?          @map("old_value") @db.Text
  newValue   String?          @map("new_value") @db.Text
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  user  User @relation("UserChanges", fields: [userId], references: [id])
  actor User @relation("UserChangesMade", fields: [actorId], references: [id])

  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("user_changes")
}

// Spec 0002: who may ask welinc-auth for tokens (spec 0001 section 4). Seeded from env by
// `npm run seed:clients`. Holds public keys only, never a client's private key.
enum ClientKind {
  FIRST_PARTY_WEB
  CONFIDENTIAL
  PUBLIC_NATIVE
  SERVICE
}

model OAuthClient {
  id            String               @id @db.VarChar(64)
  kind          ClientKind
  // Null only for the portal
  system        SystemType?
  // authorization_code, refresh_token, client_credentials, mobile_login, sso
  grants        String[]
  userAudiences String[]             @map("user_audiences")
  // { "<audience>": ["<scope>", ...] }
  serviceScopes Json                 @default("{}") @map("service_scopes")
  redirectUris  String[]             @default([]) @map("redirect_uris")
  webAddress    String?              @map("web_address") @db.VarChar(255)
  // Spec 0004, AC-18: { "<SYSTEM>": ["<role code>", ...] }. A system missing from it means every
  // role of that system may use this client. Set only by seed:clients
  allowedRoles  Json                 @default("{}") @map("allowed_roles")
  // { "keys": [public ES256 JWK with kid] }
  jwks          Json?
  isActive      Boolean              @default(true) @map("is_active")
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  assertionJtis ClientAssertionJti[]
  sessions      Session[]            @relation("SessionLoginClient")
  refreshTokens RefreshToken[]       @relation("RefreshTokenClient")
  loginRequests LoginRequest[]       @relation("LoginRequestClient")
  authCodes     AuthorizationCode[]  @relation("AuthorizationCodeClient")

  @@map("oauth_clients")
}

// A client assertion's jti, kept until it expires so it can't be replayed (spec 0002, AC-17).
// The primary key enforces one use per client, across replicas.
model ClientAssertionJti {
  clientId  String      @map("client_id") @db.VarChar(64)
  jti       String      @db.VarChar(128)
  expiresAt DateTime    @map("expires_at") @db.Timestamptz(6)
  client    OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@id([clientId, jti])
  @@index([expiresAt])
  @@map("client_assertion_jtis")
}

// Spec 0005: the user directory change feed. Both tables, the backfill and the deferred triggers
// that write `directory_changes` live in the hand written migration 20261111000000_directory_feed;
// these models only keep later `migrate dev` runs from dropping them. Never write these tables
// from code: the triggers on `users` and `user_roles` own them.

// One row: the epoch every directory cursor carries (a restored database gets a new one)
model DirectoryFeed {
  id    Boolean @id @default(true)
  epoch String  @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  @@map("directory_feed")
}

model DirectoryChange {
  seq       BigInt                 @id @default(autoincrement())
  // pg_current_xact_id() of the writing transaction; read order is (txid, seq)
  txid      Unsupported("xid8")    @default(dbgenerated("pg_current_xact_id()"))
  // No relation: a hard delete must keep its `deleted` row
  userId    String                 @map("user_id") @db.Uuid
  // created, updated, roles_changed, activated, deactivated, deleted (check constraint)
  type      String
  systems   SystemType[]
  // { id, name, email, contact, profilePicture, isActive, deletedAt, updatedAt, roles }
  snapshot  Json
  createdAt DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([txid, userId])
  @@index([txid, seq])
  @@index([userId, txid, seq])
  @@index([systems], type: Gin)
  @@map("directory_changes")
}
