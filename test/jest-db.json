{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testRegex": ".*\\.db-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "tsconfig": {
          "allowJs": true,
          "module": "commonjs",
          "moduleResolution": "node10",
          "resolvePackageJsonExports": false
        }
      }
    ]
  },
  "testEnvironment": "node",
  "testTimeout": 60000
}
